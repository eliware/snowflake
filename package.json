{
    "name": "@eliware/snowflake",
    "type": "module",
    "version": "2.0.0",
    "description": "A minimal Node.js Snowflake ID generator (Discord-compatible). Provides BigInt-safe generators with configurable epoch and worker ID.",
    "engines": {
        "node": ">=26"
    },
    "types": "src/index.d.ts",
    "files": [
        "src",
        "README.md",
        "LICENSE",
        "RELEASE_NOTES.md",
        "examples"
    ],
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "types": "./src/index.d.ts",
            "import": "./src/index.mjs"
        }
    },
    "scripts": {
        "test": "eliware-test",
        "lint": "eliware-test --lint",
        "audit": "npm audit --omit=dev --audit-level=moderate",
        "typecheck": "tsc --project tsconfig.json",
        "pack": "npm pack --dry-run"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/eliware/snowflake.git"
    },
    "keywords": [
        "snowflake",
        "snowflake-id",
        "id-generator",
        "discord",
        "unique-id",
        "bigint",
        "nodejs",
        "esm"
    ],
    "author": "Eli Sterling, eliware.org <eli@eliware.org>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/eliware/snowflake/issues"
    },
    "homepage": "https://github.com/eliware/snowflake#readme",
    "devDependencies": {
        "@eliware/test": "^3.0.0",
        "typescript": "^7.0.2"
    }
}

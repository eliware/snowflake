{
    "name": "@eliware/snowflake",
    "type": "module",
    "version": "1.1.2",
    "description": "A minimal Node.js Snowflake ID generator (Discord-compatible). Provides BigInt-safe generators with configurable epoch and worker ID.",
    "main": "index.mjs",
    "types": "index.d.ts",
    "files": [
        "index.mjs",
        "index.d.ts",
        "README.md",
        "LICENSE"
    ],
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "import": "./index.mjs"
        }
    },
    "scripts": {
        "test": "npx --node-options=\"--experimental-vm-modules --no-warnings\" jest --detectOpenHandles --silent --coverage",
        "test:gaps": "npm test -- --coverageReporters=text 2>&1 | awk '!/100%/'",
        "lint": "npx oxlint ."
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/eliware/snowflake.git"
    },
    "keywords": [
        "snowflake",
        "snowflake-id",
        "id-generator",
        "discord",
        "unique-id",
        "bigint",
        "nodejs",
        "esm"
    ],
    "author": "Eli Sterling, eliware.org <eli@eliware.org>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/eliware/snowflake/issues"
    },
    "homepage": "https://github.com/eliware/snowflake#readme",
    "devDependencies": {
        "jest": "^30.4.2"
    },
    "jest": {
        "testEnvironment": "node",
        "testMatch": [
            "**/?(*.)+(spec|test).[jt]s?(x)",
            "**/?(*.)+(spec|test).mjs"
        ]
    },
    "dependencies": {
        "@eliware/common": "^1.1.4"
    }
}